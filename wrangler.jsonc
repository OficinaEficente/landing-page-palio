{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curso-reparo-palio",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
